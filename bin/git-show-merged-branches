#!/usr/bin/env bash

# 1. Dynamically find the upstream parent repo url from git config or git remote
parent_remote=$(git remote -v | grep 'upstream' | head -n 1 | awk '{print $2}')

# Fallback: If upstream isn't set, look for the original fork source via 'origin' config
if [ -z "$parent_remote" ]; then
    parent_remote=$(git config --get remote.origin.url | sed 's/\.git$//')
fi

# 2. Add the upstream if it doesn't already exist and a parent was found
if ! git remote | grep -q "upstream" && [ ! -z "$parent_remote" ]; then
    # Extracts the parent project path to format an upstream track event
    git remote add upstream "$parent_remote"
fi

# 3. Remote event: Fetch updates across all remotes and prune deleted branches
git fetch --all --prune

# 4. Identify the active dynamic default branch 
default_branch=$(git_extra_default_branch 2>/dev/null || git remote show origin | sed -n 's/^[[:space:]]*HEAD branch:[[:space:]]*//p' || echo "main")

# 5. Clean and execute the local changes via sed and grep
git branch --no-color --merged | \
    grep -vE "^(\*|\+)" | \
    sed 's/^[[:space:]]*//' | \
    grep -Fvx -e "$default_branch" -e "main" -e "master" -e "trunk" -e "svn" | \
    xargs -r git branch -d
